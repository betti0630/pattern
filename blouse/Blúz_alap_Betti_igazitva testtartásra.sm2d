<?xml version="1.0" encoding="UTF-8"?>
<pattern>
    <!--Pattern created with Seamly2D v2026.8.31.143 (https://seamly.io).-->
    <version>0.7.4</version>
    <unit>cm</unit>
    <description/>
    <notes/>
    <measurements>../measurements/individual/Bettimeasurements.smis</measurements>
    <variables>
        <variable description="Testmagasság" formula="height" name="#tm"/>
        <variable description="Mellbőség" formula="bust_circ/2" name="#mb"/>
        <variable description="Csípőbőség" formula="hip_circ/2" name="#csb"/>
        <variable description="Derékbőség" formula="waist_circ/2" name="#db"/>
        <variable description="Mellbőség öltöztetési bőség" formula="5.5" name="#mb_öb"/>
        <variable description="Hónaljmélység" formula="neck_side_to_bust_b" name="#hm"/>
        <variable description="Hónaljmélység öltöztetési bőség" formula="2.5" name="#hm_öb"/>
        <variable description="Hátaderékhossz" formula="neck_back_to_waist_b" name="#hdh"/>
        <variable description="Csípőmélység" formula="waist_to_hip_f" name="#cm"/>
        <variable description="Hátszélesség" formula="armfold_to_armfold_b/2" name="#hsz"/>
        <variable description="Hátszélesség öltöztetési bőség" formula="1.5" name="#hsz_öb"/>
        <variable description="Hónaljszélesség" formula="12" name="#hósz"/>
        <variable description="Hónaljszélesség öltöztetési bőség" formula="2.5" name="#hósz_öb"/>
        <variable description="Elejeszélesség (a mellbőség legszélesebb pontján mérve, a próbán mért 17 cm-es összefogás alapján -8,5 cm-rel csökkentve, mivel az a teljes elejére vonatkozott, ami félmintában a fele)" formula="bust_arc_f/2-8.5" name="#esz"/>
        <variable description="Elejeszélesség öltöztetési bőség" formula="1.5" name="#esz_öb"/>
        <variable description="Nyakszélesség" formula="neck_width/2" name="#nysz"/>
        <variable description="Háta-nyaktőmagasság" formula="3" name="#hnyt"/>
        <variable description="Elejederékhossz" formula="#tm/10*2+#mb/10*2.5-1" name="#edh"/>
        <variable description="Válszélesség" formula="shoulder_length+1" name="#vsz"/>
        <variable description="Melltávolság EK-től" formula="bustpoint_to_bustpoint/2" name="#mt"/>
        <variable description="Mellformázó mélysége (könyv szerinti alapérték)" formula="#mb/10*3-7" name="#mfm_alap"/>
        <variable description="Mellkivét korrekció = tényleges bustpoint_to_neck_side mínusz a mintában jelenleg meglévő nyakoldal-mellcsúcs (MP) távolság" formula="bustpoint_to_neck_side-Line_M1_MP" name="#fba"/>
        <variable description="Mellformázó mélysége, a tényleges bustpoint_to_neck_side méretre korrigálva (a próbában bevált +8 cm-es szélesítés törölve, mert a csökkentett elejeszélesség mellett már nem kellett)" formula="#mfm_alap+#fba+0" name="#mfm"/>
        <variable description="Ujjhossz" formula="66" name="#uh"/>
        <variable description="Mell mélysége a hónaljvonal alatt (a próba alapján 12-ről 4,5-re csökkentve, mert túl lecsúsztatva ült)" formula="4.5" name="#mellmelyseg"/>
        <variable description="A mellkivét vége ennyivel álljon meg a valódi mellcsúcs (MP) előtt, hogy ne legyen kúpos/kellemetlen a varrás pont a mellbimbón" formula="2.5" name="#dart_vege_tavolsag"/>
        <variable description="A deltoid (elejei kivét) középpontja ennyivel esik K/K2 alá" formula="#mellmelyseg/3" name="#delta_kozep"/>
        <variable description="Derék öltöztetési bősége (kicsit lazábbra véve, hogy ne kelljen mindent kivétben levenni)" formula="5" name="#derek_ob"/>
        <variable description="Derék célszélesség (db/2 + öltöztetési bőség)" formula="#db+#derek_ob" name="#derek_cel"/>
        <variable description="Mellvonal teljes fél-szélessége (hát+hónalj+eleje, kivétek nélkül)" formula="#hsz+#hsz_öb+#hósz+#hósz_öb+#esz+#esz_öb" name="#mellvonal_szelesseg"/>
        <variable description="Összes szükséges derékkivét (a jelenlegi mellvonal-szélesség és a célderék közötti különbség)" formula="#mellvonal_szelesseg-#derek_cel" name="#derek_kivet_osszesen"/>
        <variable description="Oldalvarrás karcsúsítása összesen (visszavéve, mert a K-nak több jut belőle)" formula="2" name="#oldal_kivet"/>
        <variable description="Hátkivét összesen (változatlan, könyv szerinti)" formula="2.5" name="#hat_kivet"/>
        <variable description="Az elejére jutó összes kivét (a teljes szükségletből levonva az oldalvarrást és a hátkivétet), két kivétre szétosztva" formula="#derek_kivet_osszesen-#oldal_kivet-#hat_kivet" name="#eleje_kivet_osszesen"/>
        <variable description="Az elejei kivét (K) szárának hossza (egyetlen kivét, 2 szár)" formula="#eleje_kivet_osszesen/2" name="#eleje_szar"/>
        <variable description="Vállvonal emelése (magas váll miatt)" formula="2" name="#vv_emeles"/>
        <variable description="Vállpont csúsztatása feszes tartás miatt" formula="3" name="#vp_csusztatas"/>
        <variable description="Vállvonaligazítás feszesség miatt (hátul lefelé, elöl felfelé)" formula="1" name="#vv_igazitas_feszesseg"/>
    </variables>
