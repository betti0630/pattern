<?xml version="1.0" encoding="UTF-8"?>
<pattern>
    <!--Pattern created with Seamly2D v2026.8.24.201 (https://seamly.io).-->
    <version>0.7.4</version>
    <unit>cm</unit>
    <description/>
    <notes>Mellvarrás (mellformázó varrás) nélküli blúzalap, a könyv 7.3.2. fejezete (86-89/93-95. old., 7.16. ábra) alapján. Ez a szerkesztési lépés a mellformázó nélküli, kényelmes bőségű alapmintát adja - még Betti méreteire nincs korrigálva, és a karöltő-/nyakívgörbék kézzel finomítandók.</notes>
    <measurements>../measurements/individual/Bettimeasurements.smis</measurements>
    <variables>
        <variable description="Testmagasság" formula="height" name="#tm"/>
        <variable description="Mellbőség" formula="bust_circ/2" name="#mb"/>
        <variable description="Csípőbőség" formula="hip_circ/2" name="#csb"/>
        <variable description="Derékbőség" formula="waist_circ/2" name="#db"/>
        <variable description="Hónaljmélység" formula="#tm/10+#mb/10*2.5-8.4" name="#hm"/>
        <variable description="Hónaljmélység öltöztetési bősége (mellvarrás nélküli alapnál nagyobb, mint a mellformázós blúznál)" formula="3" name="#hm_öb"/>
        <variable description="Hátaderékhossz" formula="#tm/10*2+#mb/10+2" name="#hdh"/>
        <variable description="Csípőmélység" formula="#tm/10+#csb/10-2" name="#cm"/>
        <variable description="Hátszélesség" formula="#mb/10*2.5+5.5" name="#hsz"/>
        <variable description="Hátszélesség öltöztetési bősége" formula="1.5" name="#hsz_öb"/>
        <variable description="Hónaljszélesség" formula="#mb/10*2.5-1.5" name="#hósz"/>
        <variable description="Hónaljszélesség öltöztetési bősége (mellvarrás nélküli alapnál nagyobb)" formula="3" name="#hósz_öb"/>
        <variable description="Elejeszélesség" formula="#mb/10*5-4" name="#esz"/>
        <variable description="Elejeszélesség öltöztetési bősége" formula="2" name="#esz_öb"/>
        <variable description="Nyakszélesség (hátul és elöl egyaránt)" formula="#mb/10+2" name="#nysz"/>
        <variable description="Háta-nyaktőmagasság" formula="#mb/10*0.5+0.5" name="#hnyt"/>
        <variable description="Elejederékhossz (a kedvezőbb váll- és karöltő-kialakítás érdekében 1 cm-rel rövidítve, a könyv szerint)" formula="#tm/10*2+#mb/10*2.5-1-1" name="#edh"/>
        <variable description="Vállszélesség (elöl; hátul ehhez jön még 0,5 cm betartás, lásd K2 pont)" formula="shoulder_length+1" name="#vsz"/>
        <variable description="Ujjhossz" formula="#tm/10*3.5+#mb/10*0.5" name="#uh"/>
        <variable description="Eleje karöltőhossz" formula="25" name="#köhe"/>
        <variable description="Háta karöltőhossz" formula="25.5" name="#köhh"/>
    </variables>
