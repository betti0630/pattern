<?xml version="1.0" encoding="UTF-8"?>
<pattern>
    <!--Pattern created with Seamly2D v2026.8.24.201 (https://seamly.io).-->
    <version>0.7.4</version>
    <unit>cm</unit>
    <description/>
    <notes>Rugalmas (mindkét irányban nyúló) jersey pólóalap, a Blúz_mellvarrás_nélkül_alap_Betti.sm2d-ből átalakítva. Három fő változtatás a szövött blúzhoz képest: (1) az öltöztetési bőségek jelentősen csökkentve, helyenként negatívba fordítva, mert a rugalmas anyag maga adja a testhezállást - a mellvonal fél-szélessége most kb. 99 cm teljes körfogatra jön ki, szemben a tényleges 102 cm-es mellbőségeddel (kb. -3 cm negatív bőség); (2) a nyakkivágás szélesebb és mélyebb, kerekebb formára húzva; (3) az ujj rövidre véve (kb. 20 cm, könyök fölé érő rövidujj). FONTOS: ezek a konkrét számok (a negatív bőség mértéke, a nyak mélysége, az ujjhossz) nincsenek próbadarabbal ellenőrizve - ez az első nekifutás, amit rugalmas anyagon ki kell próbálni, és utána finomítani, pont úgy, ahogy a szövött blúznál is próbadarab alapján korrigáltunk.</notes>
    <patternName>Rugalmas póló</patternName>
    <patternNumber/>
    <company/>
    <customer>Dudás Beáta</customer>
    <patternLabel dateFormat="yyyy-MM-dd" timeFormat="hh:mm:ss">
        <line alignment="0" bold="false" italic="false" sfIncrement="0" text="%patternName%"/>
        <line alignment="0" bold="false" italic="false" sfIncrement="0" text="%customer%"/>
        <line alignment="0" bold="false" italic="false" sfIncrement="0" text="%date%"/>
    </patternLabel>
    <measurements>../measurements/individual/Bettimeasurements.smis</measurements>
    <variables>
        <variable description="Testmagasság" formula="height" name="#tm"/>
        <variable description="Mellbőség" formula="bust_circ/2" name="#mb"/>
        <variable description="Csípőbőség" formula="hip_circ/2" name="#csb"/>
        <variable description="Derékbőség" formula="waist_circ/2" name="#db"/>
        <variable description="Hónaljmélység (közvetlenül mérve)" formula="neck_side_to_bust_b" name="#hm"/>
        <variable description="Hónaljmélység bősége (rugalmas anyagnál minimális, csak annyi, hogy a kar mozogjon)" formula="1" name="#hm_öb"/>
        <variable description="Hátaderékhossz (közvetlenül mérve)" formula="neck_back_to_waist_b" name="#hdh"/>
        <variable description="Csípőmélység (közvetlenül mérve)" formula="waist_to_hip_f" name="#cm"/>
        <variable description="Hátszélesség (közvetlenül mérve)" formula="armfold_to_armfold_b/2" name="#hsz"/>
        <variable description="Hátszélesség bősége (rugalmas anyagnál nem kell rá bőség, a nyúlás adja a mozgásteret)" formula="0" name="#hsz_öb"/>
        <variable description="Hónaljszélesség (közvetlenül mérve)" formula="12" name="#hósz"/>
        <variable description="Hónaljszélesség bősége (rugalmas anyagnál minimális)" formula="0.5" name="#hósz_öb"/>
        <variable description="Elejeszélesség (a próbán bevált Blúz_alap_Betti képlet)" formula="bust_arc_f/2-8.5" name="#esz"/>
        <variable description="Elejeszélesség bősége - NEGATÍV, mert rugalmas anyagnál a testhezálló, feszes hatáshoz a sík szélességnek kisebbnek kell lennie, mint a testméret, a nyúlás tölti ki a különbséget" formula="-1" name="#esz_öb"/>
        <variable description="Nyakszélesség" formula="neck_width/2" name="#nysz"/>
        <variable description="Háta-nyaktőmagasság" formula="3" name="#hnyt"/>
        <variable description="Mell mélysége a hónaljvonal alatt (saját mérés)" formula="4.5" name="#mellmelyseg"/>
        <variable description="Elejederékhossz (ugyanaz a logika, mint a blúznál: a könyv rövidítését a mellmélység felével kompenzálva)" formula="#tm/10*2+#mb/10*2.5-1-1+#mellmelyseg/2" name="#edh"/>
        <variable description="Vállszélesség (a másik pólódhoz képest még ennél is keskenyebbre véve - a meredekséget nem ezzel, hanem a J1v pont bevezetésével kezeljük)" formula="shoulder_length-2" name="#vsz"/>
        <variable description="J1 (elejenyakszélesség-pont) függőleges leesése - ez lapítja a váll-nyak átmenet szögét anélkül, hogy a nyakszélesség (#nysz) mérését érintené" formula="2.5" name="#j1_eses"/>
        <variable description="Ujjhossz - rövidujjra rövidítve (a blúzban 66 volt, hosszú ujj)" formula="20" name="#uh"/>
        <variable description="Eleje karöltőhossz (kiinduló becslés a háromszög-szerkesztéshez)" formula="25" name="#köhe"/>
        <variable description="Háta karöltőhossz (kiinduló becslés a háromszög-szerkesztéshez)" formula="25.5" name="#köhh"/>
        <variable description="Derék öltöztetési bősége - csökkentve, mert rugalmas anyagnál kevesebb kézi kivét kell (a blúzban 6.5 volt)" formula="2" name="#derek_ob"/>
        <variable description="Derék célszélesség (db/2 + öltöztetési bőség)" formula="#db+#derek_ob" name="#derek_cel"/>
        <variable description="Mellvonal teljes fél-szélessége (hát+hónalj+eleje, kivét nélkül)" formula="#hsz+#hsz_öb+#hósz+#hósz_öb+#esz+#esz_öb" name="#mellvonal_szelesseg"/>
        <variable description="Az oldalvarrásban szükséges derékkivét (nincs sem elejei, sem hátkivét ebben a mintában, tehát az egész ide kell hogy jusson - ezt kell az A1-A5 oldalvarrás-szerkesztésnek elérnie)" formula="#mellvonal_szelesseg-#derek_cel" name="#derek_kivet_szukseges"/>
    </variables>
