<?xml version="1.0" encoding="UTF-8"?>
<pattern>
    <!--Pattern created with Seamly2D v2026.8.24.201 (https://seamly.io).-->
    <version>0.7.4</version>
    <unit>cm</unit>
    <description/>
    <notes>Mellvarrás (mellformázó varrás) nélküli blúzalap, a könyv 7.3.2-7.3.3. fejezete alapján, a Blúz_mellvarrás_nélkül_alap.sm2d-ből átvéve, Betti méreteire (a mértékfájl már eddig is az övé volt). Ez a te dolgozó példányod: még nincs benne próbadarabból származó illesztési korrekció (mint amilyen az eredeti blúznál a #mellmelyseg vagy az #esz &quot;összefogás-teszt&quot; alapú javítása volt) - azok majd az első próbavarrás után kerülnek bele, ugyanúgy, ahogy a Blúz_alap_Betti.sm2d esetében történt.</notes>
    <measurements>../measurements/individual/Bettimeasurements.smis</measurements>
    <variables>
        <variable description="Testmagasság" formula="height" name="#tm"/>
        <variable description="Mellbőség" formula="bust_circ/2" name="#mb"/>
        <variable description="Csípőbőség" formula="hip_circ/2" name="#csb"/>
        <variable description="Derékbőség" formula="waist_circ/2" name="#db"/>
        <variable description="Hónaljmélység (a Blúz_alap_Betti mintával egyezően, közvetlenül mérve, nem a könyv arányos képletéből)" formula="neck_side_to_bust_b" name="#hm"/>
        <variable description="Hónaljmélység öltöztetési bősége (mellvarrás nélküli alapnál nagyobb, mint a mellformázós blúznál)" formula="3" name="#hm_öb"/>
        <variable description="Hátaderékhossz (közvetlenül mérve, mint a Blúz_alap_Betti mintában)" formula="neck_back_to_waist_b" name="#hdh"/>
        <variable description="Csípőmélység (közvetlenül mérve, mint a Blúz_alap_Betti mintában)" formula="waist_to_hip_f" name="#cm"/>
        <variable description="Hátszélesség (közvetlenül mérve, mint a Blúz_alap_Betti mintában)" formula="armfold_to_armfold_b/2" name="#hsz"/>
        <variable description="Hátszélesség öltöztetési bősége" formula="1.5" name="#hsz_öb"/>
        <variable description="Hónaljszélesség (közvetlenül mérve, mint a Blúz_alap_Betti mintában)" formula="12" name="#hósz"/>
        <variable description="Hónaljszélesség öltöztetési bősége (mellvarrás nélküli alapnál nagyobb)" formula="3" name="#hósz_öb"/>
        <variable description="Elejeszélesség (a próbán bevált Blúz_alap_Betti képlet: bust_arc_f/2-8,5 - érdekesség, hogy ez pontosan ugyanazt az értéket adja, mint a könyv generikus mb-képlete a te alkatodra)" formula="bust_arc_f/2-8.5" name="#esz"/>
        <variable description="Elejeszélesség öltöztetési bősége" formula="2" name="#esz_öb"/>
        <variable description="Nyakszélesség (hátul és elöl egyaránt)" formula="neck_width/2" name="#nysz"/>
        <variable description="Háta-nyaktőmagasság" formula="3" name="#hnyt"/>
        <variable description="Mell mélysége a hónaljvonal alatt (saját mérés, ugyanaz mint a Blúz_alap_Betti mintában) - itt nincs kivét, ami helyet adna neki, ezért az elejederékhossznál kompenzáljuk" formula="4.5" name="#mellmelyseg"/>
        <variable description="Elejederékhossz (a könyv 1-1 cm-es rövidítése a kedvezőbb váll-/karöltő-kialakításért, de visszaadva a mellmélység fele, mert kivét nélkül a rövidítés felhúzná az elejét a mellen - próbadarabon ellenőrizendő)" formula="#tm/10*2+#mb/10*2.5-1-1+#mellmelyseg/2" name="#edh"/>
        <variable description="Vállszélesség (elöl; hátul ehhez jön még 0,5 cm betartás, lásd K2 pont)" formula="shoulder_length+1" name="#vsz"/>
        <variable description="Ujjhossz (a Blúz_alap_Betti mintával egyező, bevált rögzített hossz, nem képlet)" formula="66" name="#uh"/>
        <variable description="Eleje karöltőhossz" formula="25" name="#köhe"/>
        <variable description="Háta karöltőhossz" formula="25.5" name="#köhh"/>
        <variable description="Derék öltöztetési bősége (kényelmes bőségű alaphoz nagyobbra véve, mint a mellformázós blúznál - ott 5 volt)" formula="6.5" name="#derek_ob"/>
        <variable description="Derék célszélesség (db/2 + öltöztetési bőség)" formula="#db+#derek_ob" name="#derek_cel"/>
        <variable description="Mellvonal teljes fél-szélessége (hát+hónalj+eleje, kivét nélkül)" formula="#hsz+#hsz_öb+#hósz+#hósz_öb+#esz+#esz_öb" name="#mellvonal_szelesseg"/>
        <variable description="Az oldalvarrásban szükséges derékkivét (nincs sem elejei, sem hátkivét ebben a mintában, tehát az egész ide kell hogy jusson - ezt kell az A1-A5 oldalvarrás-szerkesztésnek elérnie)" formula="#mellvonal_szelesseg-#derek_cel" name="#derek_kivet_szukseges"/>
        <variable description="Vállvonal emelése (magas váll miatt) - a Póló_alap_Betti mintán bevált korrekció átvezetve" formula="2" name="#vv_emelés"/>
        <variable description="Vállpont csúsztatása feszes tartás miatt - a Póló_alap_Betti mintán bevált korrekció átvezetve" formula="2" name="#vp_csusztatas"/>
        <variable description="Hónaljkerület - a Póló_alap_Betti mintán bevált érték átvezetve, ellenőrizendő, hogy szövött anyaghoz is megfelelő-e" formula="34" name="#hk"/>
        <variable description="Vállvonaligazítás feszesség miatt (hátul lefelé, elöl felfelé) - a Póló_alap_Betti mintán bevált korrekció átvezetve" formula="1" name="#vv_igazitas_feszesseg"/>
    </variables>
